# ============================================================
# GROUP 19 IMTS API Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

NODE_ENV=development
PORT=3000
API_VERSION=v1

# MySQL XAMPP default (root, no password)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=group19
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=10

# MongoDB Community default (no auth)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=group19_mongo
MONGO_POOL_SIZE=10

# Neo4j Desktop / Community default
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
LOG_LEVEL=dev
