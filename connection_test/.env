# =============================================================================
# JHB IMTS — Connection Test Environment Variables
# Pre-filled for XAMPP (MySQL), MongoDB Community, and Neo4j Desktop defaults.
# Edit only the passwords before running.
# =============================================================================

# MySQL — XAMPP default (root, no password)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=group19GA

# MongoDB — Community Edition default (no auth)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=group19GA_mongo

# Neo4j — Desktop / Community default
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
