# =============================================================================
# CITY OF JOHANNESBURG — IMTS API ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

NODE_ENV=development
PORT=3000
API_VERSION=v1

# --- MySQL (Phase 1 & 2) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=group19GA
MYSQL_USER=jhb_api_user
MYSQL_PASSWORD=your_mysql_password_here # --Group19--
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT=10000

# --- MongoDB (Phase 3) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=group19GA_mongo
MONGO_POOL_SIZE=10

# --- Neo4j (Phase 4) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j 
NEO4J_PASSWORD=your_neo4j_password_here # --- Group19 ---
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL=50

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# --- Logging ---
LOG_LEVEL=dev
